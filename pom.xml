<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.xwiki.contrib</groupId>
    <artifactId>parent-platform</artifactId>
    <version>17.10</version>
  </parent>

  <groupId>org.xwiki.contrib.advancedbookmarks</groupId>
  <artifactId>advanced-bookmarks</artifactId>
  <version>1.0-SNAPSHOT</version>
  <name>Advanced Bookmarks - Parent POM</name>
  <description>User bookmark management for XWiki: folders, a star on each page and a panel.</description>
  <packaging>pom</packaging>

  <developers>
    <developer>
      <id>cneria</id>
      <name>Christophe Neria</name>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:git://github.com/xwiki-contrib/advanced-bookmarks.git</connection>
    <developerConnection>scm:git:git@github.com:xwiki-contrib/advanced-bookmarks.git</developerConnection>
    <url>https://github.com/xwiki-contrib/advanced-bookmarks</url>
    <tag>HEAD</tag>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- The parent POM builds the issueManagement section from this Jira project key -->
    <xwiki.issueManagement.jira.id>ADVBOOK</xwiki.issueManagement.jira.id>
  </properties>

  <repositories>
    <repository>
      <id>xwiki-public</id>
      <name>XWiki public Maven repository</name>
      <url>https://nexus.xwiki.org/nexus/content/groups/public</url>
    </repository>
  </repositories>

  <pluginRepositories>
    <!-- Needed for the XWiki enforcer rules declared by the parent POM. -->
    <pluginRepository>
      <id>xwiki-public</id>
      <name>XWiki public Maven repository</name>
      <url>https://nexus.xwiki.org/nexus/content/groups/public</url>
    </pluginRepository>
  </pluginRepositories>

  <modules>
    <module>advanced-bookmarks-api</module>
    <module>advanced-bookmarks-ui</module>
  </modules>

  <profiles>
    <profile>
      <id>integration-tests</id>
      <modules>
        <module>advanced-bookmarks-test</module>
      </modules>
    </profile>
  </profiles>
</project>
